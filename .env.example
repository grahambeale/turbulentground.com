# Airtable — personal access token with data.records:write on your base
AIRTABLE_TOKEN=your_airtable_personal_access_token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Diagnostic Submissions

# Resend — API key + verified sender address
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=results@turbulentground.com

# Token signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFICATION_SECRET=your_random_hex_string

# Research project — Phase 3.1 remains unavailable unless explicitly activated.
AIRTABLE_RESEARCH_TOKEN=your_scoped_airtable_personal_access_token
RESEARCH_MAINTENANCE_KEY=your_random_maintenance_secret
RESEARCH_PUBLIC_ENTRY_ENABLED=false
RESEARCH_REFERRAL_ISSUE_ENABLED=false
RESEARCH_REFERRAL_RESOLVE_ENABLED=false
RESEARCH_SHARING_UI_ENABLED=false
RESEARCH_INCOMPLETE_REMINDER_ENABLED=false
